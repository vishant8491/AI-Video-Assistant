# ── LLM Inference (Provide at least one) ──────────────────────────────────────
# 1. Groq (Recommended: Ultra-fast & free tier)
GROQ_API_KEY=your_groq_api_key_here

# 2. Hugging Face Hub (Alternative free tier)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_hub_token_here
HF_TOKEN=your_huggingface_hub_token_here

# 3. Mistral AI (Optional fallback)
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Speech-to-Text Configuration ──────────────────────────────────────────────
# Sarvam AI API Key (Required for Hinglish audio translation & transcription)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# OpenAI Whisper local model size ("tiny", "base", "small", "medium", "large")
WHISPER_MODEL=small
